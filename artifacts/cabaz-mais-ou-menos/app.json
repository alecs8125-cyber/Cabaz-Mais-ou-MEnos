{
  "expo": {
    "name": "Cabaz Mais ou Menos",
    "slug": "cabaz-mais-ou-menos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cabaz-mais-ou-menos-logo.png",
    "scheme": "cabaz-mais-ou-menos",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/cabaz-mais-ou-menos-logo.png",
        "backgroundColor": "#1F4D3A"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F4D3A"
    }
  }
}