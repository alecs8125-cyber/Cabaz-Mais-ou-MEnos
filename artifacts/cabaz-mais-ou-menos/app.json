{
  "expo": {
    "name": "Cabaz Mais ou Menos",
    "slug": "cabaz-mais-ou-menos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cabaz-mais-ou-menos-logo.png",
    "scheme": "cabaz-mais-ou-menos",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "pt.cabazmaismenos.app",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "pt.cabazmaismenos.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/cabaz-mais-ou-menos-logo.png",
        "backgroundColor": "#1F4D3A"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1F4D3A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}